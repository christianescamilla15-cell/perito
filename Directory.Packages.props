    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.15" />
    <PackageVersion Include="Microsoft.SemanticKernel.Core" Version="1.82.0" />
    <!-- El conector de Ollama de Semantic Kernel sólo se publica como alfa (SKEXP0070); ver docs/adr/0004. -->
    <PackageVersion Include="Microsoft.SemanticKernel.Connectors.Ollama" Version="1.82.0-alpha" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
