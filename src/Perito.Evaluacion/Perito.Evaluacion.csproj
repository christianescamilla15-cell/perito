    <OutputType>Exe</OutputType>
    <RootNamespace>Perito.Evaluacion</RootNamespace>
    <AssemblyName>perito-eval</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Perito.Asistente\Perito.Asistente.csproj" />
    <ProjectReference Include="..\Perito.EnMemoria\Perito.EnMemoria.csproj" />
  </ItemGroup>
</Project>
